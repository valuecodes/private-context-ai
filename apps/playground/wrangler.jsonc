{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentic-monorepo-playground",
  // The pinned wrangler's workerd version (1.YYYYMMDD.x) caps this date; newer dates
  // fail in `wrangler dev`. Bump it together with wrangler.
  "compatibility_date": "2026-09-23",
  "observability": { "enabled": true },
  // Static assets only: Vite's build output, including public/_headers. No
  // not_found_handling: the app is a single page without routes, so unknown paths 404.
  "assets": { "directory": "./dist" },
}
