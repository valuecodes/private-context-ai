{
  "name": "desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "vite build",
    "build:app": "tauri build",
    "build:windows": "sh scripts/build-windows.sh",
    "typecheck": "tsc",
    "test": "vitest run",
    "rust:fmt": "cd src-tauri && cargo fmt --check",
    "rust:check": "cd src-tauri && cargo clippy --all-targets --locked -- -D warnings",
    "rust:test": "cd src-tauri && cargo test --locked",
    "clean": "rm -rf .turbo node_modules .cache dist"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tauri-apps/api": "2.12.1",
    "lowlight": "3.3.0",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@repo/typescript": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "vite": "8.3.1",
    "vitest": "catalog:"
  }
}
