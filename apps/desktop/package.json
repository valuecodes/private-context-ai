{
  "name": "desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "vite build",
    "build:app": "tauri build",
    "build:windows": "sh scripts/build-windows.sh",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "rust:fmt": "cd src-tauri && cargo fmt --check",
    "rust:check": "cd src-tauri && cargo clippy --all-targets --locked -- -D warnings",
    "rust:test": "cd src-tauri && cargo test --locked",
    "clean": "rm -rf .turbo node_modules .cache dist"
  },
  "dependencies": {
    "@fontsource-variable/inter": "catalog:",
    "@fontsource-variable/jetbrains-mono": "catalog:",
    "@tauri-apps/api": "catalog:",
    "lowlight": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "catalog:",
    "remark-gfm": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@tauri-apps/cli": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
