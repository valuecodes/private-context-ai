{
  "name": "private-context-ai",
  "description": "Secure local AI sandbox (in development): desktop chat against a local Ollama with encrypted history",
  "private": true,
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --type-aware --report-unused-disable-directives",
    "test": "turbo run test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "secrets:scan": "sh .github/scripts/secrets-scan.sh",
    "clean": "turbo run clean",
    "prepare": "git config --local core.hooksPath .githooks || exit 0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
