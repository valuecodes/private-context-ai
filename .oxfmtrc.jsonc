{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  // Prettier's default; oxfmt's is 100.
  "printWidth": 80,
  "trailingComma": "es5",
  "sortPackageJson": false,
  // Third-party imports, then the apps' `~/` alias, then relative imports, each
  // group separated by a blank line. Side-effect stylesheet imports go last, in
  // their own group.
  "sortImports": {
    "groups": [
      ["builtin", "external"],
      "internal",
      ["parent", "sibling", "index"],
      "side_effect_style",
      "unknown",
    ],
  },
  "sortTailwindcss": {
    "stylesheet": "./apps/playground/src/globals.css",
  },
  // Only the root .gitignore is consulted, so per-workspace ignores are
  // repeated here.
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "**/dist/",
    "**/.turbo/",
    "**/.cache/",
    "**/.wrangler/",
  ],
}
