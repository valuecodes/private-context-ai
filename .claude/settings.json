{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm format:check:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm secrets:scan:*)",
      "Bash(pnpm knip:*)",
      "Bash(pnpm --filter @repo/logger typecheck:*)",
      "Bash(pnpm --filter @repo/logger test:*)",
      "Bash(pnpm --filter desktop dev:*)",
      "Bash(pnpm --filter desktop build:*)",
      "Bash(pnpm --filter desktop typecheck:*)",
      "Bash(pnpm --filter desktop test:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo test:*)",
      "Bash(cargo check:*)"
    ],
    "deny": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(ssh:*)",
      "Read(**/.env*)",
      "Read(**/secrets/**)"
    ],
    "ask": [
      "Bash(pnpm install:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(git commit:*)"
    ],
    "defaultMode": "default"
  }
}
